#!/bin/bash

endpoint=
first=${1:-}
seen_noproxy=0
seen_empty_proxy=0
previous=
for argument in "$@"; do
  if [ "$previous" = "--noproxy" ] && [ "$argument" = "*" ]; then
    seen_noproxy=1
  fi
  if [ "$previous" = "--proxy" ] && [ -z "$argument" ]; then
    seen_empty_proxy=1
  fi
  previous=$argument
  endpoint=$argument
done

[ "$first" = "-q" ] || exit 1
[ "$seen_noproxy" = "1" ] || exit 1
[ "$seen_empty_proxy" = "1" ] || exit 1

if [ "${FAKE_CURL_FAIL:-0}" = "1" ]; then
  exit 1
fi

case "$endpoint" in
  *endpoint-one*) printf '%s\n' "${FAKE_IP_1:-45.67.89.101}" ;;
  *endpoint-two*) printf '%s\n' "${FAKE_IP_2:-45.67.89.101}" ;;
  *) exit 1 ;;
esac
