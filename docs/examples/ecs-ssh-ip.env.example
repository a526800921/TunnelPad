# 复制到仓库外的 $HOME/.config/tunnelpad/ecs-ssh-ip.env 后按本机实际路径填写。
# 这里只放非秘密参数；AccessKey/Secret 由 aliyun CLI profile 管理。
TUNNELPAD_ALIYUN_CONFIG="$HOME/.aliyun/tunnelpad-ecs-sync.json"
ALIBABA_PROFILE="tunnelpad-ecs-sync"
ALIBABA_REGION_ID="cn-chengdu"
ECS_SECURITY_GROUP_ID="<目标安全组完整 ID>"

# 阶段 0 已验证的中国直连 IPv4 回显端点；两端点必须返回同一个地址。
TUNNELPAD_IP_ENDPOINT_1="https://myip.ipip.net"
TUNNELPAD_IP_ENDPOINT_2="https://ip.3322.net"

# 可选：日志与锁位置。两者都应位于仓库外。
# TUNNELPAD_LOG_FILE="$HOME/.config/tunnelpad/ecs-ssh-ip.log"
# TUNNELPAD_LOCK_DIR="${TMPDIR:-/tmp}/tunnelpad-ecs-ssh-ip.lock"
