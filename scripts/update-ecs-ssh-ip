#!/bin/bash

# 同步本机实际公网 IPv4 到目标 ECS 的受管 SSH 安全组规则。
# 凭证和目标资源只允许从仓库外配置读取；脚本不打印云端原始响应。

set -u

EXIT_CONFIG=2
EXIT_PROBE=3
EXIT_READ=4
EXIT_AUTHORIZE=5
EXIT_REVOKE=6
EXIT_LOCK=7

SCRIPT_NAME="update-ecs-ssh-ip"
MANAGED_DESCRIPTION="tunnelpad-dynamic-ssh-managed"

CHECK_ONLY=0
case "${1:-}" in
  "") ;;
  --check) CHECK_ONLY=1; shift ;;
  --help|-h)
    cat <<'USAGE'
用法：scripts/update-ecs-ssh-ip [--check|--help]

无参数：探测两个公网 IPv4 端点，必要时先新增再清理受管 SSH /32 规则。
--check：只探测并读取安全组状态，不执行云端写操作。

默认配置：$HOME/.config/tunnelpad/ecs-ssh-ip.env
可用 TUNNELPAD_CONFIG_FILE 指定仓库外配置文件。配置只放路径、地域、
安全组和 CLI profile 等非秘密参数；AccessKey/Secret 由 aliyun profile 管理。

退出码：0 成功或已是最新；2 配置/依赖/参数错误；3 IP 探测错误；
4 云端读取错误或受管规则歧义；5 新增或新增确认失败；6 撤销失败；7 锁冲突。
USAGE
    exit 0
    ;;
  *)
    printf '%s\n' "错误：未知参数。使用 --help 查看用法。" >&2
    exit "$EXIT_CONFIG"
    ;;
esac

if [ "$#" -ne 0 ]; then
  printf '%s\n' "错误：参数过多。使用 --help 查看用法。" >&2
  exit "$EXIT_CONFIG"
fi

CONFIG_FILE=${TUNNELPAD_CONFIG_FILE:-${HOME:-}/.config/tunnelpad/ecs-ssh-ip.env}
if [ -z "$CONFIG_FILE" ] || [ ! -f "$CONFIG_FILE" ] || [ ! -r "$CONFIG_FILE" ]; then
  printf '%s\n' "错误：仓库外配置文件不存在或不可读。" >&2
  exit "$EXIT_CONFIG"
fi

# 配置文件由操作者在仓库外维护，只承载非秘密参数和 CLI profile 路径。
# 不启用 xtrace，也不把配置内容写入日志。
. "$CONFIG_FILE"

ALIYUN_CONFIG=${TUNNELPAD_ALIYUN_CONFIG:-}
PROFILE=${ALIBABA_PROFILE:-tunnelpad-ecs-sync}
REGION_ID=${ALIBABA_REGION_ID:-}
SECURITY_GROUP_ID=${ECS_SECURITY_GROUP_ID:-}
ENDPOINT_1=${TUNNELPAD_IP_ENDPOINT_1:-https://myip.ipip.net}
ENDPOINT_2=${TUNNELPAD_IP_ENDPOINT_2:-https://ip.3322.net}
LOCK_DIR=${TUNNELPAD_LOCK_DIR:-${TMPDIR:-/tmp}/tunnelpad-ecs-ssh-ip.lock}
LOG_FILE=${TUNNELPAD_LOG_FILE:-${HOME:-}/.config/tunnelpad/ecs-ssh-ip.log}

CURL_BIN=${CURL_BIN:-curl}
ALIYUN_BIN=${ALIYUN_BIN:-aliyun}
JQ_BIN=${JQ_BIN:-jq}
SHASUM_BIN=${SHASUM_BIN:-shasum}
UUIDGEN_BIN=${UUIDGEN_BIN:-uuidgen}

if [ -z "$ALIYUN_CONFIG" ] || [ ! -r "$ALIYUN_CONFIG" ] || \
   [ -z "$REGION_ID" ] || [ -z "$SECURITY_GROUP_ID" ] || \
   [ -z "$ENDPOINT_1" ] || [ -z "$ENDPOINT_2" ]; then
  printf '%s\n' "错误：缺少 ECS 配置；请检查仓库外配置文件。" >&2
  exit "$EXIT_CONFIG"
fi

for dependency in "$CURL_BIN" "$ALIYUN_BIN" "$JQ_BIN" "$SHASUM_BIN" "$UUIDGEN_BIN"; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    printf '%s\n' "错误：缺少运行依赖。" >&2
    exit "$EXIT_CONFIG"
  fi
done

hash_text() {
  printf '%s' "$1" | "$SHASUM_BIN" -a 256 | awk '{print substr($1, 1, 16)}'
}

RESOURCE_HASH=$(hash_text "$SECURITY_GROUP_ID")

log_event() {
  # 只接受调用方传入的状态、哈希和固定标签；不写原始 IP、凭证或完整资源 ID。
  log_dir=$(dirname "$LOG_FILE")
  mkdir -p "$log_dir" >/dev/null 2>&1 || true
  printf '%s %s resource=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" "$RESOURCE_HASH" >>"$LOG_FILE" 2>/dev/null || true
}

fail() {
  log_event "$2"
  printf '%s\n' "$1" >&2
  exit "$3"
}

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  fail "错误：已有同步进程持有本地锁。" "lock_busy" "$EXIT_LOCK"
fi
cleanup_lock() {
  rmdir "$LOCK_DIR" >/dev/null 2>&1 || true
}
trap cleanup_lock EXIT INT TERM

is_public_ipv4() {
  candidate=$1
  old_ifs=$IFS
  IFS=.
  # shellcheck disable=SC2086
  set -- $candidate
  IFS=$old_ifs
  [ "$#" -eq 4 ] || return 1
  for octet in "$@"; do
    case "$octet" in
      ''|*[!0-9]*) return 1 ;;
    esac
    [ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] 2>/dev/null || return 1
  done
  a=$1; b=$2; c=$3
  [ "$a" -eq 0 ] && return 1
  [ "$a" -eq 10 ] && return 1
  [ "$a" -eq 100 ] && [ "$b" -ge 64 ] && [ "$b" -le 127 ] && return 1
  [ "$a" -eq 127 ] && return 1
  [ "$a" -eq 169 ] && [ "$b" -eq 254 ] && return 1
  [ "$a" -eq 172 ] && [ "$b" -ge 16 ] && [ "$b" -le 31 ] && return 1
  [ "$a" -eq 192 ] && [ "$b" -eq 0 ] && [ "$c" -eq 0 ] && return 1
  [ "$a" -eq 192 ] && [ "$b" -eq 0 ] && [ "$c" -eq 2 ] && return 1
  [ "$a" -eq 192 ] && [ "$b" -eq 168 ] && return 1
  [ "$a" -eq 198 ] && [ "$b" -ge 18 ] && [ "$b" -le 19 ] && return 1
  [ "$a" -eq 198 ] && [ "$b" -eq 51 ] && [ "$c" -eq 100 ] && return 1
  [ "$a" -eq 203 ] && [ "$b" -eq 0 ] && [ "$c" -eq 113 ] && return 1
  [ "$a" -ge 224 ] && return 1
  return 0
}

extract_ipv4() {
  body=$1
  candidates=$(printf '%s\n' "$body" | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' 2>/dev/null || true)
  count=$(printf '%s\n' "$candidates" | awk 'NF {n++} END {print n+0}')
  [ "$count" -eq 1 ] || return 1
  candidate=$(printf '%s\n' "$candidates" | awk 'NF {print; exit}')
  is_public_ipv4 "$candidate" || return 1
  printf '%s' "$candidate"
}

probe_endpoint() {
  endpoint=$1
  body=$("$CURL_BIN" -4fsS --max-time 20 "$endpoint" 2>/dev/null) || return 1
  extract_ipv4 "$body"
}

log_event "start mode=$([ "$CHECK_ONLY" -eq 1 ] && printf check || printf sync)"
ip_1=$(probe_endpoint "$ENDPOINT_1") || fail "错误：第一个公网 IPv4 探测失败。" "probe_failed" "$EXIT_PROBE"
ip_2=$(probe_endpoint "$ENDPOINT_2") || fail "错误：第二个公网 IPv4 探测失败。" "probe_failed" "$EXIT_PROBE"
if [ "$ip_1" != "$ip_2" ]; then
  fail "错误：两个公网 IPv4 探测结果不一致，已停止写入。" "probe_mismatch" "$EXIT_PROBE"
fi
SOURCE_HASH=$(hash_text "$ip_1")
DESIRED_CIDR="$ip_1/32"

api_error_output() {
  printf '%s\n' "$1" | grep -Eqi '(ErrorCode|SDK\.ServerError|^[[:space:]]*ERROR:|Invalid[A-Za-z]+\.)'
}

aliyun_call() {
  action=$1
  shift
  output=$("$ALIYUN_BIN" --config-path "$ALIYUN_CONFIG" --profile "$PROFILE" ecs "$action" \
    --RegionId "$REGION_ID" --SecurityGroupId "$SECURITY_GROUP_ID" "$@" 2>&1)
  status=$?
  if [ "$status" -ne 0 ] || api_error_output "$output"; then
    return 1
  fi
  printf '%s\n' "$output"
}

describe_rules() {
  description_output=$(aliyun_call DescribeSecurityGroupAttribute --Direction ingress --NicType intranet) || return 1
  if ! printf '%s\n' "$description_output" | "$JQ_BIN" -e '(.Permissions.Permission? | type) == "array"' >/dev/null 2>&1; then
    return 1
  fi
  # 只把严格描述匹配的规则交给后续流程；原始响应不进入日志或终端。
  printf '%s\n' "$description_output" | "$JQ_BIN" -c '[.Permissions.Permission[]? | select((.Description // "") == "tunnelpad-dynamic-ssh-managed" and ((.Direction // "") | ascii_downcase) == "ingress" and ((.IpProtocol // "") | ascii_downcase) == "tcp" and (.PortRange // "") == "22/22" and ((.Policy // "") | ascii_downcase) == "accept" and ((.NicType // "") | ascii_downcase) == "intranet")]'
}

read_rules() {
  MANAGED_RULES=$(describe_rules) || return 1
  if ! managed_count=$(printf '%s\n' "$MANAGED_RULES" | "$JQ_BIN" -r 'length'); then
    return 1
  fi
  if [ "$managed_count" -gt 1 ]; then
    return 2
  fi
  if [ "$managed_count" -eq 1 ]; then
    OLD_RULE_ID=$(printf '%s\n' "$MANAGED_RULES" | "$JQ_BIN" -r '.[0].SecurityGroupRuleId // empty')
    OLD_CIDR=$(printf '%s\n' "$MANAGED_RULES" | "$JQ_BIN" -r '.[0].SourceCidrIp // empty')
    [ -n "$OLD_RULE_ID" ] && [ -n "$OLD_CIDR" ] || return 1
  else
    OLD_RULE_ID=
    OLD_CIDR=
  fi
  return 0
}

read_rules
read_status=$?
[ "$read_status" -eq 0 ] || {
  [ "$read_status" -eq 2 ] && fail "错误：发现多条受管 SSH 规则，已停止写入。" "managed_ambiguous" "$EXIT_READ"
  fail "错误：无法读取或解析 ECS 安全组。" "describe_failed" "$EXIT_READ"
}

if [ "$CHECK_ONLY" -eq 1 ]; then
  if [ "$managed_count" -eq 1 ] && [ "$OLD_CIDR" = "$DESIRED_CIDR" ]; then
    log_event "check already_current source=$SOURCE_HASH rule=$(hash_text "$OLD_RULE_ID")"
  elif [ "$managed_count" -eq 1 ]; then
    log_event "check update_required source=$SOURCE_HASH old=$(hash_text "$OLD_RULE_ID")"
  else
    log_event "check missing_managed_rule source=$SOURCE_HASH"
  fi
  printf '%s\n' "检查完成：探测和安全组读取成功，未执行写操作。"
  exit 0
fi

if [ "$managed_count" -eq 1 ] && [ "$OLD_CIDR" = "$DESIRED_CIDR" ]; then
  log_event "already_current source=$SOURCE_HASH rule=$(hash_text "$OLD_RULE_ID")"
  printf '%s\n' "同步完成：受管 SSH 规则已是当前来源。"
  exit 0
fi

client_token=$("$UUIDGEN_BIN" 2>/dev/null) || fail "错误：无法生成云端请求令牌。" "client_token_failed" "$EXIT_CONFIG"
[ -n "$client_token" ] || fail "错误：无法生成云端请求令牌。" "client_token_failed" "$EXIT_CONFIG"

had_old_rule=$managed_count
old_rule_id_before_authorize=$OLD_RULE_ID

authorize_output=$(aliyun_call AuthorizeSecurityGroup \
  --IpProtocol TCP --PortRange 22/22 --SourceCidrIp "$DESIRED_CIDR" \
  --NicType intranet --Policy accept --Priority 1 \
  --Description "$MANAGED_DESCRIPTION" --ClientToken "$client_token")
authorize_status=$?
if [ "$authorize_status" -ne 0 ]; then
  # API 返回未知错误时重新读取，避免把“已落云但响应丢失”误判为未执行。
  log_event "authorize_uncertain source=$SOURCE_HASH"
fi

# 新增后立即查询确认；确认失败时不撤销旧规则。
read_rules
confirm_status=$?
if [ "$confirm_status" -ne 0 ] && ! { [ "$confirm_status" -eq 2 ] && [ "$managed_count" -eq 2 ]; }; then
  fail "错误：新增规则后无法确认安全组状态，未撤销旧规则。" "authorize_unconfirmed source=$SOURCE_HASH" "$EXIT_AUTHORIZE"
fi
desired_count=$(printf '%s\n' "$MANAGED_RULES" | "$JQ_BIN" --arg cidr "$DESIRED_CIDR" '[.[] | select(.SourceCidrIp == $cidr)] | length')
if [ "$desired_count" -ne 1 ] || [ "$managed_count" -ne 1 ] && [ "$managed_count" -ne 2 ]; then
  if [ "$authorize_status" -ne 0 ]; then
    fail "错误：新增请求返回异常且未观察到当前规则，旧规则未变更。" "authorize_failed source=$SOURCE_HASH" "$EXIT_AUTHORIZE"
  fi
  fail "错误：新增规则后状态不符合预期，未撤销旧规则。" "authorize_unconfirmed source=$SOURCE_HASH" "$EXIT_AUTHORIZE"
fi

if [ "$had_old_rule" -eq 0 ]; then
  if [ "$managed_count" -ne 1 ]; then
    fail "错误：首次新增后出现多条受管规则，未继续写入。" "authorize_ambiguous source=$SOURCE_HASH" "$EXIT_AUTHORIZE"
  fi
  # 原先没有受管规则；新增并确认后即完成。
  log_event "authorized source=$SOURCE_HASH"
  printf '%s\n' "同步完成：已新增并确认当前 SSH 规则。"
  exit 0
fi

if [ "$managed_count" -eq 1 ] && [ "$desired_count" -eq 1 ]; then
  # 并发操作者可能已清理旧规则；重新查询已证明最终状态收敛，无需重复撤销。
  log_event "synchronized source=$SOURCE_HASH old_rule_gone=1"
  printf '%s\n' "同步完成：当前 SSH 规则已确认，旧规则已不存在。"
  exit 0
fi

if [ "$managed_count" -ne 2 ]; then
  fail "错误：新增规则后受管规则状态不符合预期，未撤销旧规则。" "authorize_ambiguous source=$SOURCE_HASH" "$EXIT_AUTHORIZE"
fi

# 有旧规则时只按此前查询到的精确规则 ID 撤销，不按端口或来源批量删除。
old_rule_id_before_revoke=$old_rule_id_before_authorize
revoke_token=$("$UUIDGEN_BIN" 2>/dev/null) || fail "错误：无法生成云端撤销令牌。" "revoke_token_failed source=$SOURCE_HASH" "$EXIT_REVOKE"
[ -n "$revoke_token" ] || fail "错误：无法生成云端撤销令牌。" "revoke_token_failed source=$SOURCE_HASH" "$EXIT_REVOKE"
revoke_output=$(aliyun_call RevokeSecurityGroup \
  --SecurityGroupRuleId.1 "$old_rule_id_before_revoke" --ClientToken "$revoke_token")
revoke_status=$?

# 无论撤销请求返回成功还是“规则不存在”，都重新读取状态收敛；只有新规则唯一存在才算成功。
read_rules
final_read_status=$?
if [ "$final_read_status" -eq 0 ]; then
  final_desired_count=$(printf '%s\n' "$MANAGED_RULES" | "$JQ_BIN" --arg cidr "$DESIRED_CIDR" '[.[] | select(.SourceCidrIp == $cidr)] | length')
else
  final_desired_count=0
fi
if [ "$final_read_status" -ne 0 ] || [ "$managed_count" -ne 1 ] || [ "$final_desired_count" -ne 1 ]; then
  fail "错误：撤销旧 SSH 规则未完成；当前新旧规则均保留，请通过 Workbench 检查后重试。" "revoke_failed source=$SOURCE_HASH" "$EXIT_REVOKE"
fi

log_event "synchronized source=$SOURCE_HASH old_rule=$(hash_text "$old_rule_id_before_revoke")"
printf '%s\n' "同步完成：已确认当前规则并清理上一条受管规则。"
